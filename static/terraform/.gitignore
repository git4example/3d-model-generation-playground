# ============================================
# 3D Model Inference Project - .gitignore
# ============================================

# ----------------
# Terraform
# ----------------
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
terraform.tfvars
.terraform.lock.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep example files
!terraform.tfvars.example

# ----------------
# Python / Backend
# ----------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv

# PyTorch model cache
.cache/
models/cache/
*.pth
*.ckpt
*.safetensors

# ----------------
# Node / Frontend
# ----------------
node_modules/
.next/
out/
.cache/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Dependencies
package-lock.json
yarn.lock

# Keep pnpm-lock if you use pnpm
!pnpm-lock.yaml

# ----------------
# Kubernetes
# ----------------
# Keep all Helm charts and manifests
# Only ignore generated files
*.generated.yaml
*.tgz

# ----------------
# IDE / Editors
# ----------------
.vscode/
.idea/
*.swp
*.swo
*~

# ----------------
# Environment & Secrets
# ----------------
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
secrets/
credentials/

# ----------------
# Logs
# ----------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----------------
# OS Files
# ----------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ----------------
# Docker
# ----------------
.dockerignore

# ----------------
# Misc
# ----------------
*.bak
*.tmp
*.temp
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
